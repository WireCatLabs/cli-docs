{
  "extends": ["./config/wirecat/biome.base.json"],
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/out",
      "!**/.source",
      "!content/docs/*/",
      "!pnpm-lock.yaml",
      "!next-env.d.ts",
      "!design",
      "!lib/search-language.generated.js",
      "!lib/search-language.generated.d.ts",
      "!.docs-tooling",
      "!.impeccable",
      "!**/.worktrees",
      "!config/wirecat"
    ]
  },
  "overrides": [
    {
      "includes": ["components/landing/**"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
