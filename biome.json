{
  "extends": ["@leemour/cli-core/biome"],
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/out",
      "!**/.source",
      "!content/docs/*/",
      "!pnpm-lock.yaml",
      "!next-env.d.ts",
      "!design"
    ]
  },
  "overrides": [
    {
      "includes": ["components/landing/**"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    }
  ]
}
