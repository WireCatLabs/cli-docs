{
  "config": {
    "extends": "./config/wirecat/markdownlint.json"
  },
  "globs": [
    "content/docs/*.{md,mdx}",
    "docs/AUTHORING.md",
    "docs/README.md",
    "docs/STRUCTURE.md",
    "docs/TERMINOLOGY.md",
    "docs/REVIEWING.md"
  ],
  "ignores": ["content/docs/*/", "node_modules", ".docs-tooling"]
}
