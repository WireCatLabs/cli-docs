#!/usr/bin/env bash
# Screenshot a report page at desktop and phone width, light and dark, for one look before publishing.
# Usage: check <page.html> [out-dir] [height, default 14000: reports are long and a short shot hides the end]
set -euo pipefail

page="$(realpath "$1")"
out="${2:-$(dirname "$page")/shots}"
height="${3:-14000}"
mkdir -p "$out"
chrome="$(command -v google-chrome || command -v chromium || command -v chromium-browser)" || {
  echo "needs google-chrome or chromium on PATH" >&2
  exit 1
}

shoot() {
  local name="$1" width="$2" scheme="$3"
  "$chrome" --headless=new --disable-gpu --hide-scrollbars --window-size="$width,$height" \
    --blink-settings=preferredColorScheme="$scheme" --virtual-time-budget=8000 \
    --screenshot="$out/$name.png" "file://$page" >/dev/null 2>&1
  echo "$out/$name.png"
}

shoot desktop-light 1280 1
shoot desktop-dark 1280 0
shoot phone-light 390 1
shoot phone-dark 390 0
