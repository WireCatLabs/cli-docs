#!/usr/bin/env bash
# Posts a Markdown file to the WireCat Discord releases webhook channel.
# The webhook stays in the keyring and never reaches the screen, even when curl fails.
set -euo pipefail

file="${1:?usage: bin/post-discord <message.md>}"
webhook="$(secret-tool lookup service discord account wirecat-releases-webhook || true)"
if [ -z "$webhook" ]; then
  echo "No webhook in the keyring. Store it with:" >&2
  echo "  secret-tool store --label='WireCat Discord releases webhook' service discord account wirecat-releases-webhook" >&2
  exit 1
fi

body="$(python3 -c 'import json,sys; print(json.dumps({"content": open(sys.argv[1]).read()}))' "$file")"
status="$(curl -sS -o /dev/null -w '%{http_code}' -H 'Content-Type: application/json' -d "$body" \
  --url "$webhook" 2>/dev/null || echo "000")"
case "$status" in
  2*) echo "Posted to Discord." ;;
  *) echo "Discord refused the post (HTTP $status)." >&2; exit 1 ;;
esac
