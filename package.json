{
  "name": "cli-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "sync": "node --experimental-strip-types scripts/sync.ts",
    "docs:localize": "node --experimental-strip-types scripts/localize.ts",
    "dev": "next dev",
    "build": "pnpm sync && next build",
    "start": "serve out",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:links": "node --experimental-strip-types scripts/check-links.ts",
    "prepare": "lefthook install || true",
    "search:generate": "node scripts/build-search-language.mjs",
    "search:check": "node scripts/build-search-language.mjs --check",
    "test:browser": "playwright test",
    "docs:updates": "node --experimental-strip-types scripts/docs-updates.ts",
    "check:seo": "node --experimental-strip-types scripts/check-seo.ts",
    "docs:pack": "node --experimental-strip-types scripts/source-pack.ts",
    "docs:contracts": "node --experimental-strip-types scripts/docs-contracts.ts",
    "docs:quality": "node --experimental-strip-types scripts/docs-quality.ts",
    "docs:lint": "markdownlint-cli2",
    "docs:spell": "cspell lint --config cspell.json --no-progress",
    "docs:check": "pnpm docs:lint && pnpm docs:quality --strict",
    "docs:wiki:install": "sh scripts/codewiki-install.sh",
    "docs:wiki": ".docs-tooling/codewiki-venv/bin/python scripts/codewiki-trial.py",
    "docs:wiki:review": "python3 scripts/codewiki-review.py",
    "docs:release-notes": "node --experimental-strip-types scripts/release-notes.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "cn": "^0.3.0",
    "fumadocs-core": "16.15.17",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.17",
    "github-slugger": "2.0.0",
    "lucide-react": "^1.47.0",
    "mdast-util-from-markdown": "2.0.2",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "beautiful-mermaid": "1.1.3",
    "shell-quote": "1.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@leemour/cli-core": "0.17.2",
    "@leemour/cli-messaging": "0.168.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "lefthook": "^2.1.15",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "repomix": "1.18.1",
    "markdownlint-cli2": "0.23.3",
    "cspell": "10.3.6",
    "@cspell/dict-es-es": "3.0.9",
    "@cspell/dict-ru_ru": "2.3.3",
    "@types/shell-quote": "1.7.5"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
