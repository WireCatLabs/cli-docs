{
  "name": "cli-docs",
  "license": "Apache-2.0",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "sync": "node --experimental-strip-types scripts/sync.ts",
    "docs:localize": "node --experimental-strip-types scripts/localize.ts",
    "docs:translation": "node --experimental-strip-types scripts/translation.ts",
    "dev": "next dev",
    "build": "pnpm sync && next build",
    "start": "serve out",
    "lint": "biome check . && pnpm check:browser-tests",
    "lint:fix": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:assets": "node scripts/check-export-size.mjs",
    "check:links": "node --experimental-strip-types scripts/check-links.ts",
    "prepare": "lefthook install || true",
    "search:generate": "node scripts/build-search-language.mjs",
    "search:check": "node scripts/build-search-language.mjs --check",
    "test:browser": "playwright test --config=playwright.smoke.config.ts",
    "test:browser:full": "playwright test",
    "docs:updates": "node --experimental-strip-types scripts/docs-updates.ts",
    "check:seo": "node --experimental-strip-types scripts/check-seo.ts",
    "docs:pack": "node --experimental-strip-types scripts/source-pack.ts",
    "docs:contracts": "node --experimental-strip-types scripts/docs-contracts.ts",
    "docs:quality": "node --experimental-strip-types scripts/docs-quality.ts",
    "docs:lint": "markdownlint-cli2",
    "docs:spell": "cspell lint --config cspell.json --no-progress",
    "docs:check": "pnpm docs:lint && pnpm docs:versions && pnpm docs:quality --strict",
    "docs:wiki:install": "sh scripts/codewiki-install.sh",
    "docs:wiki": ".docs-tooling/codewiki-venv/bin/python scripts/codewiki-trial.py",
    "docs:wiki:review": "python3 scripts/codewiki-review.py",
    "docs:release-notes": "node --experimental-strip-types scripts/release-notes.ts",
    "docs:report-fixture": "node scripts/docs-report-fixture.mjs",
    "docs:versions": "node scripts/check-doc-versions.mjs",
    "landing:export": "node --experimental-strip-types scripts/export-editorial.mjs",
    "design:serve": "node scripts/serve-designs.mjs",
    "check:browser-tests": "node --experimental-strip-types scripts/browser-test-policy.ts",
    "check:browser-timings": "node --experimental-strip-types scripts/browser-test-policy.ts --report playwright-report/results.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "beautiful-mermaid": "1.1.3",
    "cn": "^0.3.0",
    "fumadocs-core": "16.15.17",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.17",
    "github-slugger": "2.0.0",
    "lucide-react": "^1.47.0",
    "mdast-util-from-markdown": "2.0.2",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shell-quote": "1.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "8.0.7",
    "@biomejs/biome": "^2.5.15",
    "@cspell/dict-es-es": "3.0.9",
    "@cspell/dict-ru_ru": "2.3.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/shell-quote": "1.7.5",
    "@wirecat/cli-core": "0.18.1",
    "@wirecat/cli-messaging": "0.216.0",
    "cspell": "10.3.6",
    "esbuild": "^0.28.2",
    "lefthook": "^2.1.15",
    "markdownlint-cli2": "0.23.3",
    "postcss": "^8.5.28",
    "repomix": "1.18.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
