{
	admin off
	auto_https off
	persist_config off
}

# Serves the built site the way Cloudflare Pages does. Keep the headers in step with public/_headers.
:8080 {
	root * /srv

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	header /api/search/* Content-Type application/gzip
	@skills path_regexp ^/\.well-known/(agent-)?skills/[^/]+/SKILL\.md$
	header @skills Content-Type "text/markdown; charset=utf-8"
	header /.well-known/microsoft-identity-association.json Content-Type application/json
	header /install.ps1 Content-Type "text/plain; charset=utf-8"
	header /_next/static/* Cache-Control "public, max-age=31536000, immutable"

	@pages_only path /_headers /_redirects
	respond @pages_only 404

	@html path_regexp html ^(/.+)\.html$
	redir @html {re.html.1} 308

	encode zstd gzip
	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
