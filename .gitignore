# deps
/node_modules

# generated content
.source

# test & build
/coverage
/.next/
/out/
/build
*.tsbuildinfo

# misc
.DS_Store
*.pem
/.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# others
.env*.local
.vercel
next-env.d.ts
# filled by `pnpm sync` from each tool's repository
/content/docs/*/
!/content/docs/desktop/
!/content/docs/voip/
/content/upstream/
/public/*/
# Redirect stubs for removed documentation pages: public/<lang>/docs/<old-slug>/index.html
!/public/en/
!/public/ru/
!/public/es/
# Only the Microsoft publisher-domain proof is authored here; the rest of .well-known is generated by sync.
!/public/.well-known/
/public/.well-known/*
!/public/.well-known/microsoft-identity-association.json

# Local landing fonts are source assets, not synced tool files.
!/public/fonts/
!/public/screenshots/

# Generated Python caches are not source.
__pycache__/
*.py[cod]

/docs/research/

/test-results/

/playwright-report/

# Generated release audit reports and source proposals
.docs-updates/

# Private local WireCat review skills and evidence.
/.agents/skills/
/.audit/

# Local documentation research and release contracts
/.docs-tooling
# Local archives of old checkouts; never published
/archive-*/

# The working trail, kept on the machine doing the work; archived in the private repository.
/CLEANUP.md
/HANDOFF.md
/docs/plans/
